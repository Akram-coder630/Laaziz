void manageDeliberation()
{
    int ch;
    char sid[20], mt[50], sec[10];
    printf("\n1.Assign Grade  2.Modify  3.By Module  4.Results\nChoice: ");
    scanf("%d", &ch);

    if (ch == 1)
    {
        GradeNode *newNode = (GradeNode *)malloc(sizeof(GradeNode));
        printf("\nStudent ID: ");
        scanf("%s", newNode->studentId);
        printf("\nModule Title: ");
        scanf("%s", newNode->moduleTitle);
        printf("\nNote: ");
        scanf("%f", &newNode->note);
        newNode->next = gradesHead;
        gradesHead = newNode;
    }
    else if (ch == 2)
    {
        printf("\nID: ");
        scanf("%s", sid);
        printf("\nModule: ");
        scanf("%s", mt);
        GradeNode *curr = gradesHead;
        while (curr != NULL)
        {
            if (stringsEqual(curr->studentId, sid) && stringsEqual(curr->moduleTitle, mt))
            {
                printf("\nNew Grade: ");
                scanf("%f", &curr->note);
                return;
            }
            curr = curr->next;
        }
    }
    else if (ch == 3)
    {
        printf("\nModule: ");
        scanf("%s", mt);
        GradeNode *curr = gradesHead;
        while (curr != NULL)
        {
            if (stringsEqual(curr->moduleTitle, mt))
                printf("ID %s: %.2f\n", curr->studentId, curr->note);
            curr = curr->next;
        }
    }
    else if (ch == 4)
    {
        printf("\nFilter by section? (y/n): ");
        char f;
        scanf(" %c", &f);
        if (f == 'y')
        {
            printf("\nSection: ");
            scanf("%s", sec);
        }

        // Clear previous results list
        while (resultsHead != NULL)
        {
            ResultNode *tmp = resultsHead;
            resultsHead = resultsHead->next;
            free(tmp);
        }

        StudentNode *sCurr = studentsHead;
        while (sCurr != NULL)
        {
            if (f == 'y' && !stringsEqual(sCurr->section, sec))
            {
                sCurr = sCurr->next;
                continue;
            }

            float pts = 0.0f;
            float coefs = 0.0f;
            GradeNode *gCurr = gradesHead;
            while (gCurr != NULL)
            {
                if (stringsEqual(gCurr->studentId, sCurr->id))
                {
                    ModuleNode *mCurr = modulesHead;
                    while (mCurr != NULL)
                    {
                        if (stringsEqual(mCurr->title, gCurr->moduleTitle))
                        {
                            pts += gCurr->note * (float)mCurr->coefficient;
                            coefs += (float)mCurr->coefficient;
                        }
                        mCurr = mCurr->next;
                    }
                }
                gCurr = gCurr->next;
            }

            ResultNode *res = (ResultNode *)malloc(sizeof(ResultNode));
            stringCopy(res->studentId, sCurr->id);
            res->average = (coefs > 0.0f) ? (pts / coefs) : 0.0f;
            if (res->average >= 10.0f)
                stringCopy(res->status, "Pass");
            else
                stringCopy(res->status, "Fail");

            printf("%s %s: Avg %.2f [%s]\n", sCurr->firstName, sCurr->lastName, res->average, res->status);
            res->next = resultsHead;
            resultsHead = res;
            sCurr = sCurr->next;
        }
    }
}

