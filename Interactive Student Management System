// --- Grades and Deliberation Struct Logic ---

void manageGradesAndDeliberation()
{
    int ch;
    char sid[20], mt[50], sec[10];
    printf("\n1.Assign\n2.Modify\n3.By Module\n4.By Student \n5.By Section\nChoice: ");
    scanf("%d", &ch);

    if (ch == 1)
    {
        grades = (Grade *)realloc(grades, (gradeCount + 1) * sizeof(Grade));
        printf("\nID: ");
        scanf("%s", sid);
        printf("\nModule: ");
        scanf("%s", mt);
        printf("\nGrade: ");
        scanf("%f", &grades[gradeCount].note);
        stringCopy(grades[gradeCount].studentId, sid);
        stringCopy(grades[gradeCount].moduleTitle, mt);
        gradeCount++;
    }
    else if (ch == 2)
    {
        printf("\nID: ");
        scanf("%s", sid);
        printf("\nModule: ");
        scanf("%s", mt);
        for (size_t i = 0; i < gradeCount; i++)
        {
            if (stringsEqual(grades[i].studentId, sid) && stringsEqual(grades[i].moduleTitle, mt))
            {
                printf("\nNew Grade: ");
                scanf("%f", &grades[i].note);
                return;
            }
        }
    }
    else if (ch == 3)
    {
        printf("\nModule: ");
        scanf("%s", mt);
        for (size_t i = 0; i < gradeCount; i++)
        {
            if (stringsEqual(grades[i].moduleTitle, mt))
                printf("ID %s: Grade %.2f\n", grades[i].studentId, grades[i].note);
        }
    }
    else if (ch == 4 || ch == 5)
    {
        if (ch == 5)
        {
            printf("\nSection: ");
            scanf("%s", sec);
        }
        // Update Deliberation Result struct array
        resultCount = 0;
        free(results);
        results = NULL;
        for (size_t i = 0; i < studentCount; i++)
        {
            if (ch == 5 && !stringsEqual(students[i].section, sec))
                continue;
            float pts = 0.0f;
            float coefs = 0.0f;
            for (size_t j = 0; j < gradeCount; j++)
            {
                if (stringsEqual(grades[j].studentId, students[i].id))
                {
                    for (size_t k = 0; k < moduleCount; k++)
                    {
                        if (stringsEqual(modules[k].title, grades[j].moduleTitle))
                        {
                            pts += grades[j].note * (float)modules[k].coefficient;
                            coefs += (float)modules[k].coefficient;
                        }
                    }
                }
            }
            results = (Result *)realloc(results, (resultCount + 1) * sizeof(Result));
            stringCopy(results[resultCount].studentId, students[i].id);
            results[resultCount].average = (coefs > 0.0f) ? (pts / coefs) : 0.0f;
            if (results[resultCount].average >= 10.0f)
                stringCopy(results[resultCount].status, "Pass");
            else
                stringCopy(results[resultCount].status, "Fail");

            printf("%s %s: Avg %.2f [%s]\n", students[i].firstName, students[i].lastName, results[resultCount].average, results[resultCount].status);
            resultCount++;
        }
    }
}

int main()
{
    int ch;
    do
    {
        printf("\n===== SIGL SYSTEM =====\n1.Students\n2.Modules\n3.Grades/Delib\n4.Save\n5.Load\n0.Exit\nChoice: ");
        scanf("%d", &ch);
        switch (ch)
        {
        case 1:
            manageStudents();
            break;
        case 2:
            manageModules();
            break;
        case 3:
            manageGradesAndDeliberation();
            break;
        case 4:
            saveToFile();
            break;
        case 5:
            loadFromFile();
            break;
        }
    } while (ch != 0);
    free(students);
    free(modules);
    free(grades);
    free(results);
    return 0;
}



// Linked Lists

#include <stdio.h>
#include <stdlib.h>

// ---Linked Lists---

typedef struct StudentNode
{
    char id[20];
    char firstName[30];
    char lastName[30];
    char section[10];
    struct StudentNode *next;
} StudentNode;

typedef struct ModuleNode
{
    char title[50];
    int coefficient;
    struct ModuleNode *next;
} ModuleNode;

typedef struct GradeNode
{
    char studentId[20];
    char moduleTitle[50];
    float note;
    struct GradeNode *next;
} GradeNode;

typedef struct ResultNode
{
    char studentId[20];
    float average;
    char status[10];
    struct ResultNode *next;
} ResultNode;

// --- Global List Heads ---
StudentNode *studentsHead = NULL;
ModuleNode *modulesHead = NULL;
GradeNode *gradesHead = NULL;
ResultNode *resultsHead = NULL;

// --- Utility Functions (Manual Logic) ---

int stringsEqual(char *s1, char *s2)
{
    int i = 0;
    while (s1[i] != '\0' && s2[i] != '\0')
    {
        if (s1[i] != s2[i])
            return 0;
        i++;
    }
    return (s1[i] == s2[i]);
}

void stringCopy(char *dest, char *src)
{
    int i = 0;
    while (src[i] != '\0')
    {
        dest[i] = src[i];
        i++;
    }
    dest[i] = '\0';
}

// --- File Operations (Record-by-Record) ---

void saveToFile()
{
    FILE *f;

    f = fopen("students.bin", "wb");
    if (f == NULL)
        printf("Error opening students.bin\n");
    else
    {
        StudentNode *curr = studentsHead;
        while (curr != NULL)
        {
            fwrite(curr, sizeof(char) * 90, 1, f); // Manual size to avoid saving next ptr
            curr = curr->next;
        }
        fclose(f);
    }

    f = fopen("modules.bin", "wb");
    if (f == NULL)
        printf("Error opening modules.bin\n");
    else
    {
        ModuleNode *curr = modulesHead;
        while (curr != NULL)
        {
            fwrite(curr, sizeof(char) * 54, 1, f);
            curr = curr->next;
        }
        fclose(f);
    }

    f = fopen("grades.bin", "wb");
    if (f == NULL)
        printf("Error opening grades.bin\n");
    else
    {
        GradeNode *curr = gradesHead;
        while (curr != NULL)
        {
            fwrite(curr, sizeof(char) * 74, 1, f);
            curr = curr->next;
        }
        fclose(f);
    }
    printf("Data saved successfully.\n");
}

void loadFromFile()
{
    FILE *f;
    char tempBuffer[100];

    f = fopen("students.bin", "rb");
    if (f != NULL)
    {
        while (fread(tempBuffer, 90, 1, f) == 1)
        {
            StudentNode *newNode = (StudentNode *)malloc(sizeof(StudentNode));
            for (int i = 0; i < 90; i++)
                ((char *)newNode)[i] = tempBuffer[i];
            newNode->next = studentsHead;
            studentsHead = newNode;
        }
        fclose(f);
    }

    f = fopen("modules.bin", "rb");
    if (f != NULL)
    {
        while (fread(tempBuffer, 54, 1, f) == 1)
        {
            ModuleNode *newNode = (ModuleNode *)malloc(sizeof(ModuleNode));
            for (int i = 0; i < 54; i++)
                ((char *)newNode)[i] = tempBuffer[i];
            newNode->next = modulesHead;
            modulesHead = newNode;
        }
        fclose(f);
    }

    f = fopen("grades.bin", "rb");
    if (f != NULL)
    {
        while (fread(tempBuffer, 74, 1, f) == 1)
        {
            GradeNode *newNode = (GradeNode *)malloc(sizeof(GradeNode));
            for (int i = 0; i < 74; i++)
                ((char *)newNode)[i] = tempBuffer[i];
            newNode->next = gradesHead;
            gradesHead = newNode;
        }
        fclose(f);
    }
    printf("Data loaded.\n");
}

