// Dynamic Arrays

#include <stdio.h>
#include <stdlib.h>

// Dynamic Arrays
typedef struct
{
    char id[20];
    char firstName[30];
    char lastName[30];
    char section[10];
} Student;

typedef struct
{
    char title[50];
    int coefficient;
} Module;

typedef struct
{
    char studentId[20];
    char moduleTitle[50];
    float note;
} Grade;

// The "Deliberation" structure
typedef struct
{
    char studentId[20];
    float average;
    char status[10]; // "Pass" or "Fail"
} Result;

// --- Global Dynamic Arrays ---
Student *students = NULL;
size_t studentCount = 0;

Module *modules = NULL;
size_t moduleCount = 0;

Grade *grades = NULL;
size_t gradeCount = 0;

Result *results = NULL;
size_t resultCount = 0;

// --- Utility Functions (Manual Logic) ---

int stringsEqual(char *s1, char *s2)
{
    int i = 0;
    while (s1[i] != '\0' && s2[i] != '\0')
    {
        if (s1[i] != s2[i])
            return 0;
        i++;
    }
    return (s1[i] == s2[i]);
}

void stringCopy(char *dest, char *src)
{
    int i = 0;
    while (src[i] != '\0')
    {
        dest[i] = src[i];
        i++;
    }
    dest[i] = '\0';
}

// --- File Operations (With Error Handling) ---

void saveToFile()
{
    FILE *f;
    f = fopen("students.bin", "wb");
    if (f == NULL)
        printf("Error: students.bin could not be opened for writing.\n");
    else
    {
        fwrite(students, sizeof(Student), studentCount, f);
        fclose(f);
    }

    f = fopen("modules.bin", "wb");
    if (f == NULL)
        printf("Error: modules.bin could not be opened for writing.\n");
    else
    {
        fwrite(modules, sizeof(Module), moduleCount, f);
        fclose(f);
    }

    f = fopen("grades.bin", "wb");
    if (f == NULL)
        printf("Error: grades.bin could not be opened for writing.\n");
    else
    {
        fwrite(grades, sizeof(Grade), gradeCount, f);
        fclose(f);
    }

    f = fopen("deliberation.bin", "wb");
    if (f == NULL)
        printf("Error: deliberation.bin could not be opened for writing.\n");
    else
    {
        fwrite(results, sizeof(Result), resultCount, f);
        fclose(f);
    }

    printf("All data successfully saved to files.\n");
}

void loadFromFile()
{
    FILE *f;
    Student st;
    Module mt;
    Grade gr;
    Result rs;

    f = fopen("students.bin", "rb");
    if (f == NULL)
        printf("Error: students.bin not found.\n");
    else
    {
        studentCount = 0;
        while (fread(&st, sizeof(Student), 1, f) == 1)
        {
            students = (Student *)realloc(students, (studentCount + 1) * sizeof(Student));
            students[studentCount++] = st;
        }
        fclose(f);
    }

    f = fopen("modules.bin", "rb");
    if (f == NULL)
        printf("Error: modules.bin not found.\n");
    else
    {
        moduleCount = 0;
        while (fread(&mt, sizeof(Module), 1, f) == 1)
        {
            modules = (Module *)realloc(modules, (moduleCount + 1) * sizeof(Module));
            modules[moduleCount++] = mt;
        }
        fclose(f);
    }

    f = fopen("grades.bin", "rb");
    if (f == NULL)
        printf("Error: grades.bin not found.\n");
    else
    {
        gradeCount = 0;
        while (fread(&gr, sizeof(Grade), 1, f) == 1)
        {
            grades = (Grade *)realloc(grades, (gradeCount + 1) * sizeof(Grade));
            grades[gradeCount++] = gr;
        }
        fclose(f);
    }

    f = fopen("deliberation.bin", "rb");
    if (f == NULL)
        printf("Error: deliberation.bin not found.\n");
    else
    {
        resultCount = 0;
        while (fread(&rs, sizeof(Result), 1, f) == 1)
        {
            results = (Result *)realloc(results, (resultCount + 1) * sizeof(Result));
            results[resultCount++] = rs;
        }
        fclose(f);
    }
    printf("All available data loaded.\n");
}

// --- Management Logic ---

void manageStudents()
{
    int ch;
    char search[30];
    printf("\n1.Add\n2.Delete(ID)\n3.Modify(ID)\n4.Search\n5.Display\nChoice: ");
    scanf("%d", &ch);
    if (ch == 1)
    {
        students = (Student *)realloc(students, (studentCount + 1) * sizeof(Student));
        printf("\nID: ");
        scanf("%s", students[studentCount].id);
        printf("\nFirst: ");
        scanf("%s", students[studentCount].firstName);
        printf("\nLast: ");
        scanf("%s", students[studentCount].lastName);
        printf("\nSec: ");
        scanf("%s", students[studentCount].section);
        studentCount++;
    }
    else if (ch == 2)
    {
        printf("\nID to delete: ");
        scanf("%s", search);
        for (size_t i = 0; i < studentCount; i++)
        {
            if (stringsEqual(students[i].id, search))
            {
                for (size_t j = i; j < studentCount - 1; j++)
                    students[j] = students[j + 1];
                studentCount--;
                printf("Deleted.\n");
                return;
            }
        }
    }
    else if (ch == 3)
    {
        printf("\nID to modify: ");
        scanf("%s", search);
        for (size_t i = 0; i < studentCount; i++)
        {
            if (stringsEqual(students[i].id, search))
            {
                printf("\nNew Sec: ");
                scanf("%s", students[i].section);
                return;
            }
        }
    }
    else if (ch == 4)
    {
        printf("\nEnter ID or Name: ");
        scanf("%s", search);
        for (size_t i = 0; i < studentCount; i++)
        {
            if (stringsEqual(students[i].id, search) || stringsEqual(students[i].firstName, search))
                printf("Found: %s %s, ID: %s, Sec: %s\n", students[i].firstName, students[i].lastName, students[i].id, students[i].section);
        }
    }
    else if (ch == 5)
    {
        for (size_t i = 0; i < studentCount; i++)
            printf("ID %s: %s %s\n", students[i].id, students[i].firstName, students[i].lastName);
    }
}

