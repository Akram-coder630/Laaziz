void manageStudents()
{
    int ch;
    char search[30];
    printf("\n1.Add  2.Delete  3.Search  4.Display\nChoice: ");
    scanf("%d", &ch);

    if (ch == 1)
    {
        StudentNode *newNode = (StudentNode *)malloc(sizeof(StudentNode));
        if (newNode == NULL)
        {
            printf("Memory Error\n");
